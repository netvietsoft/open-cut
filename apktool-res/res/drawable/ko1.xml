<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#0f00cae0" />
            <corners android:radius="999.0dp" />
            <stroke android:width="0.5dp" android:color="#3300cae0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="999.0dp" />
            <stroke android:width="0.5dp" android:color="#29ffffff" />
        </shape>
    </item>
</selector>
