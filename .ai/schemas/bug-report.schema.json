{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BugReportSchema",
  "type": "object",
  "required": ["task_id", "status", "command", "failed_tests", "attempt"],
  "properties": {
    "task_id": {"type": "string"},
    "status": {"type": "string", "enum": ["FAILED", "RESOLVED"]},
    "command": {"type": "string"},
    "failed_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "file": {"type": "string"},
          "error": {"type": "string"}
        }
      }
    },
    "attempt": {"type": "integer"}
  }
}
