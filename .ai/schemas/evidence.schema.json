{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidenceSchema",
  "type": "object",
  "required": ["evidence_id", "feature_id", "classification", "kind", "claim", "confidence"],
  "properties": {
    "evidence_id": {"type": "string"},
    "feature_id": {"type": "string"},
    "classification": {"type": "string", "enum": ["OBSERVED", "INFERRED", "NEW_DESIGN"]},
    "kind": {"type": "string"},
    "claim": {"type": "string"},
    "source_reference": {"type": "object"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
