{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskSchema",
  "type": "object",
  "required": ["task_id", "title", "assigned_role", "status", "acceptance_criteria", "scope"],
  "properties": {
    "task_id": {"type": "string"},
    "feature_id": {"type": "string"},
    "title": {"type": "string"},
    "assigned_role": {"type": "string"},
    "required_skills": {"type": "array", "items": {"type": "string"}},
    "status": {
      "type": "string",
      "enum": ["backlog", "ready", "running", "review", "blocked", "done"]
    },
    "scope": {
      "type": "object",
      "properties": {
        "files_allowed": {"type": "array", "items": {"type": "string"}},
        "files_forbidden": {"type": "array", "items": {"type": "string"}}
      }
    },
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "budget": {
      "type": "object",
      "properties": {
        "max_cycles": {"type": "integer"},
        "max_minutes": {"type": "integer"}
      }
    }
  }
}
