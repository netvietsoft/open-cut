{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DesignTaskSchema",
  "type": "object",
  "required": ["design_id", "task_id", "status", "ui_impact", "approval"],
  "properties": {
    "design_id": {"type": "string"},
    "task_id": {"type": "string"},
    "feature_id": {"type": "string"},
    "status": {
      "type": "string",
      "enum": ["draft", "designing", "visual_qa", "awaiting_approval", "approved", "rejected", "implementing", "completed"]
    },
    "ui_impact": {"type": "boolean"},
    "targets": {"type": "array", "items": {"type": "string"}},
    "approval": {
      "type": "object",
      "properties": {
        "required": {"type": "boolean"},
        "decision": {"type": ["string", "null"]},
        "approved_by": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"]}
      }
    }
  }
}
