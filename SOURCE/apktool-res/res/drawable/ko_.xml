<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:startColor="#ffffffff" android:endColor="#80ffffff" android:angle="45.0" />
                    <corners android:radius="24.0dp" />
                </shape>
            </item>
            <item android:left="1.0px" android:top="1.0px" android:right="1.0px" android:bottom="1.0px">
                <shape android:shape="rectangle">
                    <solid android:color="#fbfdff" />
                    <corners android:radius="24.0dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:startColor="#ffffffff" android:endColor="#80ffffff" android:angle="45.0" />
                    <corners android:radius="24.0dp" />
                </shape>
            </item>
            <item android:left="1.0px" android:top="1.0px" android:right="1.0px" android:bottom="1.0px">
                <shape android:shape="rectangle">
                    <solid android:color="#99f9fcff" />
                    <corners android:radius="24.0dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
