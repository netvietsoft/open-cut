<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="false">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="2.0dp" android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="2.0dp" android:color="@color/knt" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
