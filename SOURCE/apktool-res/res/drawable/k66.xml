<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="40.0dp" />
            <solid android:color="@color/knt" />
            <stroke android:width="2.0dp" android:color="@color/knt" />
        </shape>
    </item>
    <item android:state_selected="false">
        <shape android:shape="rectangle">
            <corners android:radius="40.0dp" />
            <stroke android:width="1.0dp" android:color="#1affffff" />
        </shape>
    </item>
</selector>
