<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape>
                    <size android:height="60.0dp" android:width="60.0dp" />
                    <solid android:color="#0affffff" />
                    <stroke android:width="1.1999817dp" android:color="#00cae0" />
                    <corners android:radius="30.0dp" />
                </shape>
            </item>
            <item android:gravity="center" android:drawable="@drawable/mhm" />
        </layer-list>
    </item>
    <item android:state_selected="false">
        <layer-list>
            <item>
                <shape>
                    <size android:height="60.0dp" android:width="60.0dp" />
                    <solid android:color="#0affffff" />
                    <corners android:radius="30.0dp" />
                </shape>
            </item>
            <item android:gravity="center" android:drawable="@drawable/ohl" />
        </layer-list>
    </item>
</selector>
