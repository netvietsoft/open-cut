# NextAI OpenCut - Mẫu Biến Môi Trường Hệ Thống

# Cổng khởi chạy máy chủ Backend API & Web CMS (Mặc định: 6033)
PORT=6033
NODE_ENV=development
HOST=0.0.0.0

# Khóa bí mật JWT
JWT_SECRET=nextai_opencut_jwt_super_secret_key_2026
JWT_EXPIRES_IN=7200s
REFRESH_TOKEN_EXPIRES_IN=30d

# Cơ sở dữ liệu PostgreSQL (hoặc SQLite local mock)
DB_TYPE=sqlite
DB_SQLITE_PATH=./data/opencut_local.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opencut_db

# Redis Cache & Session
REDIS_URL=redis://localhost:6379

# Cloudflare R2 / AWS S3 Storage
STORAGE_PROVIDER=cloudflare_r2
CLOUDFLARE_ACCOUNT_ID=mock_cf_acc_id
CLOUDFLARE_R2_ACCESS_KEY=mock_r2_access_key
CLOUDFLARE_R2_SECRET_KEY=mock_r2_secret_key
CLOUDFLARE_R2_BUCKET_NAME=nextai-opencut-assets
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://assets.nextai.com

# AI LLM Model & Endpoint
AI_PROVIDER=deepseek
AI_API_KEY=sk-mock-nextai-ai-agent-key-2026
AI_BASE_URL=https://api.deepseek.com/v1

# AdMob & Google Play Billing
ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713
GOOGLE_PLAY_LICENSE_KEY=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA_mock
